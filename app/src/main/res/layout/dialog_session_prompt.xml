<?xml version="1.0" encoding="utf-8"?>
<!-- Вопрос "выключить на этот сеанс": скорость при пробросе, масштаб при туннелировании -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/prompt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prompt_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/prompt_dont_ask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_selector_menu_item"
        android:padding="8dp"
        android:text="@string/dont_show_again"
        android:textColor="@color/selector_settings_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_prompt_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_selector_menu_item"
            android:paddingHorizontal="24dp"
            android:text="@string/cancel"
            android:textColor="@color/selector_settings_secondary" />

        <Button
            android:id="@+id/btn_prompt_ok"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_selector_menu_item"
            android:paddingHorizontal="24dp"
            android:text="@android:string/ok"
            android:textColor="@color/selector_settings_secondary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
