<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: серверы SMB с паролями не уходят ни в облачную копию, ни при переносе на новое устройство -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="smb_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="smb_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
