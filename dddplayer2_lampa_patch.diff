+package top.rootu.dddplayer.bridge
+
+/**
+ * Dispatcher used by the player to emit bridge events to the configured transport.
+ *
+ * The dispatcher simply forwards events to the underlying transport if the bridge is enabled.
+ */
+class BridgeDispatcher(
+    private val config: BridgeConfig,
+    private val transport: BridgeTransport
+) {
+    fun emit(event: BridgeEvent) {
+        if (!config.enabled) return
+        transport.send(event)
+    }
+}
