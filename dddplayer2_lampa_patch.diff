+    /**
+     * Parse bridge configuration extras from the given intent.
+     *
+     * Returns a BridgeConfig describing how the player should emit events to an external client.
+     * If no bridge extras are set the returned config will have enabled = false.
+     */
+    fun parseBridgeConfig(intent: Intent): BridgeConfig {
+        val enabled = intent.getBooleanExtra("bridge_enabled", false)
+        val sessionId = intent.getStringExtra("bridge_session_id")
+        val modeString = intent.getStringExtra("bridge_mode")?.lowercase()
+        val mode = when (modeString) {
+            "http" -> BridgeMode.HTTP
+            "websocket" -> BridgeMode.WEBSOCKET
+            else -> BridgeMode.BROADCAST
+        }
+        val callbackUrl = intent.getStringExtra("bridge_callback_url")
+        val token = intent.getStringExtra("bridge_token")
+        val emitPosition = intent.getBooleanExtra("bridge_emit_position", true)
+        val emitUserActions = intent.getBooleanExtra("bridge_emit_user_actions", true)
+        val intervalMs = intent.getLongExtra("bridge_position_interval_ms", 1000L)
+        val client = intent.getStringExtra("bridge_client") ?: "custom"
+
+        return BridgeConfig(
+            enabled = enabled,
+            sessionId = sessionId,
+            mode = mode,
+            callbackUrl = callbackUrl,
+            token = token,
+            emitPosition = emitPosition,
+            emitUserActions = emitUserActions,
+            positionIntervalMs = intervalMs,
+            client = client
+        )
+    }
