+package top.rootu.dddplayer.bridge
+
+import android.content.Context
+import android.content.Intent
+import com.google.gson.Gson
+
+/**
+ * Transport implementation that sends bridge events via Android broadcasts.
+ *
+ * This transport is intended for on-device integrations such as Lampa.
+ * The broadcast action name is fixed; clients should register a BroadcastReceiver
+ * for this action to receive events.
+ */
+class BroadcastTransport(
+    private val context: Context,
+    private val packageName: String? = null
+) : BridgeTransport {
+
+    private val gson = Gson()
+
+    override fun send(event: BridgeEvent) {
+        val intent = Intent(ACTION_EVENT)
+        packageName?.let { intent.setPackage(it) }
+        intent.putExtra(EXTRA_EVENT_JSON, gson.toJson(event))
+        intent.putExtra(EXTRA_EVENT_TYPE, event::class.simpleName)
+        context.sendBroadcast(intent)
+    }
+
+    companion object {
+        /**
+         * Action name used for all bridge event broadcasts.
+         */
+        const val ACTION_EVENT = "top.rootu.dddplayer.bridge.EVENT"
+        /**
+         * Extra name carrying the JSON-encoded event.
+         */
+        const val EXTRA_EVENT_JSON = "event_json"
+        /**
+         * Extra name carrying the simple class name of the event.
+         */
+        const val EXTRA_EVENT_TYPE = "event_type"
+    }
+}
